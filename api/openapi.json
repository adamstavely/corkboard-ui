  "info": {
    "title": "Corkboard API",
    "description": "Collaborative AI whiteboard backend. Send an access token from the identity provider as a bearer token.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "OrgDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "name"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "orgs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "orgs"
        ]
      },
      "BoardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "orgId",
          "title",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateBoardDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateBoardDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "BoardDocumentDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ]
      },
      "SearchHitDto": {
        "type": "object",
        "properties": {
          "boardId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "snippets": {
            "description": "Matching passages as HTML-escaped text, with the matches wrapped in <mark>.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "boardId",
          "title",
          "updatedAt",
          "snippets"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "role",
          "userId",
          "name",
          "email"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "invitedByName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "email",
          "invitedByName",
          "createdAt"
        ]
      },
      "MembersDto": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberDto"
            }
          },
          "invites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InviteDto"
            }
          }
        },
        "required": [
          "members",
          "invites"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          }
        },
        "required": [
          "role"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          }
        },
        "required": [
          "role",
          "email"
        ]
      },
      "MyInviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "orgName": {
            "type": "string"
          },
          "invitedByName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "role",
          "id",
          "orgId",
          "orgName",
          "invitedByName"
        ]
      }
    }
  }
}
