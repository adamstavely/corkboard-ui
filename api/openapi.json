  "info": {
    "title": "Corkboard API",
    "description": "Collaborative AI whiteboard backend. Send an access token from the identity provider as a bearer token.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "OrgDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "name"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "orgs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "orgs"
        ]
      },
      "BoardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "orgId",
          "title",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateBoardDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateBoardDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "BoardDocumentDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ]
      },
      "SearchHitDto": {
        "type": "object",
        "properties": {
          "boardId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "snippets": {
            "description": "Matching passages as HTML-escaped text, with the matches wrapped in <mark>.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "boardId",
          "title",
          "updatedAt",
          "snippets"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "role",
          "userId",
          "name",
          "email"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "invitedByName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "email",
          "invitedByName",
          "createdAt"
        ]
      },
      "MembersDto": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberDto"
            }
          },
          "invites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InviteDto"
            }
          }
        },
        "required": [
          "members",
          "invites"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          }
        },
        "required": [
          "role"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          }
        },
        "required": [
          "role",
          "email"
        ]
      },
      "MyInviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "orgName": {
            "type": "string"
          },
          "invitedByName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "role",
          "id",
          "orgId",
          "orgName",
          "invitedByName"
        ]
      },
      "ProviderDto": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "anthropic",
              "openai"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string",
            "nullable": true
          },
          "hasKey": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "label",
          "model",
          "baseUrl",
          "hasKey",
          "createdAt"
        ]
      },
      "CreateProviderDto": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "anthropic",
              "openai"
            ],
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "What people see in the model picker, e.g. \"Claude\" or \"Llama on our GPU box\".",
            "maxLength": 80
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "baseUrl": {
            "type": "string",
            "nullable": true,
            "description": "Required for OpenAI-compatible servers; for Anthropic, only to go through a proxy.",
            "maxLength": 500,
            "format": "uri"
          },
          "apiKey": {
            "type": "string",
            "description": "Stored encrypted; omit for servers that need none (a local Ollama).",
            "maxLength": 500
          }
        },
        "required": [
          "kind",
          "label",
          "model"
        ]
      },
      "UpdateProviderDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "baseUrl": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "apiKey": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "ProviderTestDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "What the test found: it works, or which part is at fault.",
            "enum": [
              "healthy",
              "auth-failed",
              "model-unavailable",
              "unreachable",
              "error"
            ],
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "description": "The model's reply, or what went wrong."
          },
          "latencyMs": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "ok",
          "message",
          "latencyMs"
        ]
      },
      "AssistRequestDto": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "Which of the workspace's models to ask.",
            "format": "uuid"
          },
          "instruction": {
            "type": "string",
            "description": "What the person wants: a question about the board, or something to do on it.",
            "maxLength": 4000
          },
          "noteIds": {
            "description": "Notes to focus on (a selection); without them, the whole board.",
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "modelId",
          "instruction"
        ]
      },
      "AssistResultDto": {
        "type": "object",
        "properties": {
          "reply": {
            "type": "string",
            "description": "The model's answer, for the person who asked."
          },
          "notesAdded": {
            "type": "number"
          },
          "notesChanged": {
            "type": "number"
          },
          "framesAdded": {
            "type": "number",
            "description": "Frames the model made, to group notes or hold action items."
          },
          "notesMoved": {
            "type": "number",
            "description": "Existing notes the model moved into frames."
          }
        },
        "required": [
          "reply",
          "notesAdded",
          "notesChanged",
          "framesAdded",
          "notesMoved"
        ]
      }
    }
  }
}
