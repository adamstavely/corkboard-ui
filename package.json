{
  "name": "corkboard-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:gen": "ng-openapi-gen",
    "api:sync": "gh api repos/adamstavely/corkboard-api/contents/openapi.json -H 'Accept: application/vnd.github.raw' > api/openapi.json && npm run api:gen",
    "prestart": "npm run api:gen",
    "prebuild": "npm run api:gen",
    "pretest": "npm run api:gen",
    "lint:tc": "trenchcoat lint src",
    "tc:vendor": "scripts/vendor-trenchcoat.sh"
  },
  "private": true,
  "packageManager": "npm@11.21.2",
  "dependencies": {
    "@adamstavely/trenchcoat": "file:vendor/adamstavely-trenchcoat-0.20.0.tgz",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hocuspocus/provider": "4.8.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-collaboration": "3.33.1",
    "@tiptap/extension-collaboration-caret": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/y-tiptap": "3.3.0",
    "lit": "3.3.3",
    "oidc-client-ts": "3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
